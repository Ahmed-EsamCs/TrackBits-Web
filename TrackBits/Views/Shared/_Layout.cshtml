<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrackBiTs</title>
    <link rel="shortcut icon" href="~/assets/logo.svg" type="image/x-icon">
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <!-- CSS -->
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!-- External Font (Aileron) -->
    <link rel="stylesheet" href="https://use.typekit.net/wuo2dyp.css">
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    }

    <!-- Navbar -->
    <nav class="navbar navbar-expand-md bg-body-tertiary sticky-top">
        <div class="container-fluid">
            <!-- Navbar logo -->
            <a class="navbar-brand d-flex justify-content-center align-items-center" asp-action="index" asp-controller="home">
                <img src="~/assets/logo.svg" alt="Logo" width="70" height="50" class="d-inline-block align-text-top">
                TrackBiTs
            </a>
            <!-- Navbar toggler button -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar items -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" aria-current="page" asp-controller="Home" asp-action="index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Payments" ? "active" : "")" asp-controller="Payments" asp-action="payment">Pricing</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction == "Support" ? "active" : "")" asp-controller="home" asp-action="Support" >Support</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")" asp-controller="home" asp-action="About" >About</a>
                    </li>
                </ul>
                    <partial name="_LoginPartial" />
            </div>
        </div>


    </nav>


            @RenderBody()

    <footer class="tb-footer-dark mt-5">
        <div class="container py-5">

            <div class="row gy-4">

                <!-- Brand -->
                <div class="col-md-4">
                    <div class="footer-brand d-flex align-items-center mb-3">
                        <img src="~/assets/logo.svg" width="55" class="me-2" />
                        <span class="brand-text">TrackBiTs</span>
                    </div>
                    <p class="footer-desc">
                        Smart tools that help your business track, secure, and automate workflows efficiently.
                    </p>

                    <div class="social-links mt-3 d-flex">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-github"></i></a>
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <!-- Navigation -->
                <div class="col-md-2">
                    <h6 class="footer-title">Product</h6>
                    <ul class="footer-links">
                        <li><a href="/#features">Features</a></li>
                        <li><a asp-action="payment" asp-controller="Payments">Pricing</a></li>
                        <li><a target="_blank" href="https://stripe.com/">API</a></li>
                    </ul>
                </div>

                <div class="col-md-2">
                    <h6 class="footer-title">Company</h6>
                    <ul class="footer-links">
                        <li><a asp-action="about" asp-controller="home">About</a></li>
                        <li><a asp-action="support" asp-controller="Home">Support</a></li>
                        <li><a href="/#Career">Career</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h6 class="footer-title">Legal</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">Cookie Preferences</a></li>
                    </ul>
                </div>

            </div>

            <hr class="footer-divider mt-4" />

            <div class="text-center text-muted mt-3" style="color:white">
                © @DateTime.Now.Year TrackBiTs. All Rights Reserved.
            </div>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
 
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
