@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3 class="fw-bold text-primary mb-4">@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8 col-lg-7">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            @if (Model.IsEmailConfirmed)
            {
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold text-muted small ms-1">Current Email</label>
                    <div class="input-wrapper">
                        <input asp-for="Email" class="input text-success fw-bold" placeholder="Please enter your email." disabled />
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 1.2rem;"></i>
                    </div>
                    <div class="form-text text-success small mt-1">
                        <i class="bi bi-patch-check-fill me-1"></i> Verified
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold text-muted small ms-1">Current Email</label>
                    <div class="input-wrapper">
                        <input asp-for="Email" class="input" placeholder="Please enter your email." disabled />
                        <i class="bi bi-envelope"></i>
                    </div>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link text-decoration-none p-0 mt-1 small">
                        Send verification email
                    </button>
                </div>
            }

            <div class="mb-4">
                <label asp-for="Input.NewEmail" class="form-label fw-bold text-muted small ms-1">New Email</label>
                <div class="input-wrapper">
                    <input asp-for="Input.NewEmail" class="input" autocomplete="email" aria-required="true" placeholder="Enter new email address" />
                    <i class="bi bi-pencil-square"></i>
                </div>
                <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
            </div>

            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-primary w-100 py-2 fs-6 shadow-sm border-0">
                Change Email
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}