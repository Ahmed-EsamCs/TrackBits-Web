@using TrackBits.Models.Entities
@inject SignInManager<User> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<div class="settings-card">
    <h5 class="fw-bold mb-4 ps-2 text-primary">Account Settings</h5>

    <ul class="nav flex-column settings-nav">

        <li class="nav-item">
            <a class="settings-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
                <i class="bi bi-person-circle"></i>
                Profile
            </a>
        </li>

        <li class="nav-item">
            <a class="settings-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
                <i class="bi bi-envelope"></i>
                Email
            </a>
        </li>

        <li class="nav-item">
            <a class="settings-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
                <i class="bi bi-shield-lock"></i>
                Password
            </a>
        </li>

   
        @if (hasExternalLogins)
        {
            <li class="nav-item">
                <a id="external-login" class="settings-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
                    <i class="bi bi-google"></i>
                    External logins
                </a>
            </li>
        }
    </ul>
</div>