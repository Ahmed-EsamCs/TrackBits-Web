@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="fw-bold text-primary mb-4">@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8 col-lg-7">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.OldPassword" class="form-label fw-bold text-muted small ms-1">Current Password</label>
                <div class="input-wrapper">
                    <input asp-for="Input.OldPassword" class="input" autocomplete="current-password" aria-required="true" placeholder="Enter current password" />
                    <i class="bi bi-key"></i>
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-bold text-muted small ms-1">New Password</label>
                <div class="input-wrapper">
                    <input asp-for="Input.NewPassword" class="input" autocomplete="new-password" aria-required="true" placeholder="Enter new password" />
                    <i class="bi bi-lock"></i>
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-muted small ms-1">Confirm Password</label>
                <div class="input-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
                    <i class="bi bi-lock-check"></i>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-primary w-100 py-2 fs-6 shadow-sm border-0">
                Update Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}