@page
@model ForgotPasswordConfirmation

<section class="container-fluid">

<div class="row min-vh-100 justify-content-center">

<!-- Email Sent View -->
<div id="emailSentView" class="col login-section d-flex flex-column align-items-center text-center pt-4 pt-md-5">
    <!-- Header Logo -->
    <div class="app-brand d-flex flex-column align-items-center">
        <img src="~/assets/email-checkmark.png" class="img-fluid mb-2" width="150" height="150">
    </div>
    <!-- Header Text -->
    <h2 class="login-header display-5 mt-3 mb-3">Check your email!</h2>
    <!-- Paragraph -->
    <p class="login-para">An email was sent with a link for you to verify that you own this account</p>
    <!-- Back to Sign In Link -->
    <a class="text-link mt-3 mb-4" href="login.html">Back to Sign In</a>
</div>
</div>
</section>