@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}



<section class="container-fluid">


<div class="row min-vh-100 justify-content-center">

    <div class="col login-section d-flex flex-column align-items-center text-center pt-4 pt-md-5">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <!-- Header Logo -->
        <div id="emailSentView" class="app-brand d-flex flex-column align-items-center">
            <img src="~/assets/forget_password_icon.png" class="img-fluid mb-2" width="125" height="125">
        </div>
        <!-- Header Text -->
        <h2 class="login-header display-5 mt-3 mb-3">Forgot your password?</h2>
        <!-- Paragraph -->
        <p class="login-para">Enter your email and we'll send you a password reset link</p>
        <!-- Form -->
        <form method="post" class="form d-flex justify-content-center align-items-center flex-column">
            <!-- Email Input -->
            <div class="input-wrapper mb-4">
                <input class="input" asp-for="Input.Email" autocomplete="username" aria-required="true" type="email" name="email" placeholder="Email" required>
                <i class="bi bi-envelope"></i>
            </div>
            <!-- Submit Button -->
            <button class="btn-primary submit-btn mb-2" type="submit">Send Email</button>
            <!-- Back to Sign In Link -->
            <a class="text-link mt-3 mb-4" asp-page ="/Account/Login">Back to Sign In</a>
        </form>
    </div>
</div>

</section>





