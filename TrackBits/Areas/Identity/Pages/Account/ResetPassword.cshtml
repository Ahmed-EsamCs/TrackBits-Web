@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}



<section class="container-fluid">

    <div class="row min-vh-100 justify-content-center">


        <!-- Enter New Password Form View -->
        <div id="newPasswordView" class="col login-section d-flex flex-column align-items-center text-center pt-4 pt-md-5">
            <!-- Header Logo -->
            <div class="app-brand d-flex flex-column align-items-center">
                <img src="~/assets/password_lock.png" class="img-fluid mb-2" width="150" height="150">
            </div>
            <!-- Header Text -->
            <h2 class="login-header display-5 mt-3 mb-3">Reset your Password</h2>
            <!-- Form -->
            <form method="post" class="form d-flex justify-content-center align-items-center flex-column">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                <input asp-for="Input.UserId" type="hidden" />
                <!-- Password Input -->
                <div class="input-wrapper mb-1">
                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" class="input" type="password" placeholder="Enter New Password" required>
                    <i class="bi bi-lock"></i>

                </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                <!-- Confirm Password Input -->
                <div class="input-wrapper mb-4">
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" class="input" type="password" placeholder="Confirm New Password" required>
                    <i class="bi bi-lock"></i>

                </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                <!-- Submit Button -->
                <button class="btn-primary submit-btn mb-2" type="submit">Update Password</button>
                <!-- Back to Sign In Link -->
                <a class="text-link mt-3 mb-4" asp-page="/Account/Login">Back to Sign In</a>
            </form>
        </div>
    </div>

</section>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
