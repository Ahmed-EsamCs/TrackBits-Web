@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email Confirmed";
}

<div class="confirm-wrapper d-flex flex-column align-items-center justify-content-center">

    <div class="confirm-card d-flex flex-column flex-lg-row align-items-center p-4">

        <!-- Left Side: Robot -->
        <div class="robot-side mb-4 mb-lg-0">
            <img src="~/assets/robot.svg" alt="Robot" class="robot-img" />
        </div>

        <!-- Right Side: Content -->
        <div class="text-side text-center d-flex flex-column align-items-center">

            <img src="~/assets/logo.svg" width="120" class="mb-3" />

            <h2 class="title mb-2">Your email is verified! </h2>

            <p class="desc mb-3">
                Your account has been successfully confirmed.<br />
                You can now log in and start using TrackBiTs.
            </p>

            <partial name="_StatusMessage" model="Model.StatusMessage" />

            <a asp-page="/Account/Login" class="btn-primary mt-3">Go to Login</a>

        </div>

    </div>

</div>


    

